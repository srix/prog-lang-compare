{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ES2015",
    "moduleResolution": "node",
    "outDir": "./docs",
    "rootDir": "./docs",
    "strict": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["docs/**/*.ts"],
  "exclude": ["node_modules"]
}
